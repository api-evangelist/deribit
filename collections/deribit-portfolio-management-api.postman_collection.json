          "name": "Lock Portfolio",
          "request": {
            "name": "Lock Portfolio",
            "description": {
              "content": "Locks the authenticated portfolio. All currently open `DIRECT_ACCESS` orders and quotes for this portfolio are cancelled immediately. New `DIRECT_ACCESS` orders and quotes are rejected until the portfolio is unlocked.\n\nREST-submitted orders are not affected by the lock state.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "private",
